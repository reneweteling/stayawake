---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const dl = 'https://github.com/reneweteling/stayawake/releases/latest/download/StayAwake.dmg';
---
<section class="block alt" id="install">
  <div class="wrap">
    <div class="sec-head" data-reveal>
      <span class="kicker">Install</span>
      <h2>Two minutes.</h2>
      <p class="sub">Needs macOS 14 or newer on Apple Silicon.</p>
    </div>
    <div class="cols">
      <ol>
        <li data-reveal style="--d:0ms"><span>1</span><div><b>Download</b><p><a href={dl}>StayAwake.dmg</a> from the latest release.</p></div></li>
        <li data-reveal style="--d:110ms"><span>2</span><div><b>Move to Applications</b><p>Open the disk image and drag StayAwake onto the Applications folder.</p></div></li>
        <li data-reveal style="--d:220ms"><span>3</span><div><b>Approve the helper</b><p>The first time you switch it on, approve StayAwake once in System Settings, Login Items. It never asks for your password.</p></div></li>
        <li data-reveal style="--d:330ms"><span>4</span><div><b>Switch it on</b><p>Click the moon in the menu bar, flip Stay awake and close the lid.</p></div></li>
      </ol>
      <div class="right">
      <div class="story">
      <div class="mbar" aria-hidden="true"><img src={`${base}assets/icon.png`} width="20" height="20" alt="" /><span class="mono" data-mb>58°</span></div>
      <div class="card" data-story data-reveal aria-label="Example of the popover while holding awake">
        <div class="c-head">
          <svg class="ring" viewBox="0 0 56 56" width="56" height="56" aria-hidden="true"><circle class="trk" cx="28" cy="28" r="23" /><circle class="val" cx="28" cy="28" r="23" pathLength="100" /></svg>
          <b>Stay awake</b>
          <span class="sw" aria-hidden="true"></span>
        </div>
        <div class="note" data-note><span class="dot" aria-hidden="true"></span><span data-note-text>Unplugged. StayAwake keeps this Mac awake on battery.</span></div>
        <p class="mono dim" data-held>Holding for 1 h 12 min, until 18:00</p>
        <dl>
          <div><dt>CPU temperature</dt><dd data-cpu>58 °C</dd></div>
          <div><dt>Battery temperature</dt><dd>34 °C</dd></div>
          <div><dt>Battery</dt><dd data-bat>71%</dd></div>
          <div><dt>Lid</dt><dd data-lid>Closed, on battery 48 min</dd></div>
        </dl>
        <div class="next"><span class="mono lab">Next to trip</span><strong data-next>Lid on battery, 42 min left</strong><div class="track" aria-hidden="true"><i data-bar></i></div></div>
      </div>
      </div>
      <div class="src" data-reveal style="--d:150ms">
        <span class="mono lab">Or build from source</span>
        <pre><code><span class="p">$</span> git clone https://github.com/reneweteling/stayawake.git
<span class="p">$</span> cd stayawake
<span class="p">$</span> ./scripts/build.sh
<span class="p">$</span> cp -R build/StayAwake.app /Applications/</code></pre>
      </div>
      </div>
    </div>
  </div>
</section>
<style>
  .story { display: grid; gap: 10px; }
  .mbar { justify-self: end; display: inline-flex; align-items: center; gap: 8px; padding: 5px 12px 5px 8px; border-radius: 99px; background: var(--hero-bg); border: 1px solid var(--hero-line); color: var(--ink); transition: border-color .3s, color .3s; }
  .mbar img { border-radius: 5px; transition: filter .3s; }
  .mbar span { font-variant-numeric: tabular-nums; min-width: 3ch; text-align: right; }
  .c-head { display: flex; align-items: center; gap: 14px; }
  .c-head b { margin-right: auto; }
  .ring { flex: none; transform: rotate(-90deg); }
  .ring circle { fill: none; stroke-width: 6; }
  .ring .trk { stroke: #3a4a4d; }
  .ring .val { stroke: var(--safe); stroke-linecap: round; stroke-dasharray: 100; stroke-dashoffset: 28; transition: stroke-dashoffset .9s cubic-bezier(.2,.7,.2,1), stroke .4s; }
  .note { display: flex; gap: 10px; align-items: flex-start; min-height: 4.6em; padding: 12px 14px; border-radius: 12px; background: var(--safe-bg); color: var(--safe); font-size: 14px; line-height: 1.4; transition: background-color .4s, color .4s; }
  .note .dot { flex: none; width: 8px; height: 8px; margin-top: .45em; border-radius: 50%; background: currentColor; }
  .track { height: 4px; border-radius: 99px; background: #3a4a4d; margin-top: 12px; overflow: hidden; }
  .track i { display: block; height: 100%; background: var(--accent); transform-origin: left; transform: scaleX(.47); transition: transform .7s linear, background-color .4s; }
  .card { transition: border-color .4s, box-shadow .4s; }
  .sw { transition: background-color .3s; }
  .sw::after { transition: transform .3s; }
  .card.hot { border-color: var(--hot); box-shadow: 0 40px 80px -40px rgba(0,0,0,.8), 0 0 40px -12px var(--hot); }
  .card.hot .note { background: var(--careful-bg); color: var(--hot); }
  .card.hot .ring .val { stroke: var(--hot); }
  .card.off .sw { background: #3a4a4d; }
  .card.off .sw::after { transform: translateX(-18px); }
  .card.hot .track i { background: var(--hot); }
  .card.warm .ring .val { stroke: var(--accent); }
  .card.warm .note { background: var(--rebuild-bg); color: var(--accent); }
  .story.hot .mbar { border-color: var(--hot); color: var(--hot); }
  .story.hot .mbar img { filter: hue-rotate(-20deg) saturate(1.6); }
  .right { display: grid; grid-template-columns: minmax(0, 1fr); gap: 32px; }
  .card { background: var(--surface-2); border: 1px solid var(--hero-line); border-radius: 20px; padding: 24px; box-shadow: 0 40px 80px -40px rgba(0,0,0,.8); display: grid; gap: 14px; }
  .c-head { display: flex; justify-content: space-between; align-items: center; }
  .c-head b { font: 800 1.7rem/1 var(--display); text-transform: uppercase; }
  .sw { width: 42px; height: 24px; border-radius: 99px; background: var(--safe); position: relative; }
  .sw::after { content: ""; position: absolute; right: 3px; top: 3px; width: 18px; height: 18px; border-radius: 50%; background: #0d1517; }
  .dim { color: var(--muted); font-size: 12px; }
  dl { margin: 0; display: grid; gap: 8px; border-block: 1px solid var(--hero-line); padding-block: 14px; }
  dl div { display: flex; justify-content: space-between; gap: 16px; }
  dt { color: var(--muted); }
  dd { margin: 0; font-weight: 600; font-variant-numeric: tabular-nums; text-align: right; }
  .next strong { font: 800 1.4rem/1.2 var(--display); color: var(--accent); }
  .next .lab { margin-bottom: 6px; }
  .alt { background: var(--surface); border-block: 1px solid var(--line); }
  .cols > * { min-width: 0; }
  .cols { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 22px; }
  li { display: grid; grid-template-columns: 44px 1fr; gap: 16px; }
  li span { width: 44px; height: 44px; border-radius: 10px; background: var(--accent); color: var(--accent-ink); display: grid; place-items: center; font: 800 1.5rem/1 var(--display); }
  li b { font: 800 1.35rem/1.1 var(--display); text-transform: uppercase; display: block; margin-bottom: 4px; }
  li p { color: var(--muted); }
  li a { color: var(--accent); font-weight: 600; }
  .lab { display: block; font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: .1em; margin-bottom: 12px; }
  pre { margin: 0; background: var(--hero-bg); color: var(--hero-ink); border-radius: 14px; padding: 22px 24px; overflow-x: auto; font: 14px/1.9 var(--mono); }
  .p { color: var(--hero-accent); user-select: none; }
  @media (max-width: 820px) { .cols { grid-template-columns: 1fr; gap: 36px; } }
</style>
