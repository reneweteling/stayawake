---
import Popover from './Popover.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const downloadUrl = 'https://github.com/reneweteling/stayawake/releases/latest/download/StayAwake.dmg';
const githubUrl = 'https://github.com/reneweteling/stayawake';
---

<header class="hero">
  <div class="wrap">
    <div class="topline">
      <span class="brand"><img src={`${base}assets/icon.png`} alt="" width="30" height="30" />StayAwake</span>
      <span class="meta">macOS 14+ / Apple Silicon / by <a href="https://www.weteling.com" target="_blank" rel="noopener">René Weteling</a></span>
    </div>

    <div class="grid">
      <div class="copy">
        <h1><span>Agents keep working.</span> <em>Laptop in your bag.</em></h1>
        <p class="pitch">Keeps a closed MacBook awake on battery for Claude Code and Codex, and lets it sleep before it runs hot.</p>
        <div class="cta">
          <a class="btn primary" href={downloadUrl}>
            <svg width="17" height="17" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 2v8m0 0L5 7m3 3 3-3M2 13h12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
            Download for macOS
          </a>
          <a class="btn ghost" href={githubUrl} target="_blank" rel="noopener">Source on GitHub</a>
        </div>
      </div>
      <div class="shot"><Popover /></div>
    </div>
  </div>
</header>

<style>
  .hero { padding: 28px 0 112px; }
  .topline { display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .brand { display: flex; align-items: center; gap: 10px; font: 800 21px/1 var(--display); text-transform: uppercase; letter-spacing: 0; }
  .brand img { border-radius: 7px; }
  .meta { font: 12px/1 var(--mono); color: var(--dim); }
  .meta a { color: var(--muted); text-decoration: none; }
  .meta a:hover { color: var(--ink); }
  .grid { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr); gap: 56px; align-items: center; margin-top: 72px; }
  h1 { font-size: clamp(2.5rem, 4vw, 3.4rem); line-height: .98; }
  h1 span, h1 em { display: block; }
  h1 em { font-style: normal; color: var(--accent); }
  .pitch { color: var(--muted); font-size: 1.2rem; max-width: 36ch; margin-top: 24px; }
  .cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  .shot { display: flex; justify-content: flex-end; align-self: start; }

  @media (max-width: 880px) {
    .hero { padding-bottom: 80px; }
    .grid { grid-template-columns: 1fr; gap: 48px; margin-top: 56px; }
    .shot { justify-content: flex-start; }
    .meta { display: none; }
    .pitch { font-size: 1.1rem; }
    h1 span, h1 em { display: inline; }
  }
</style>
