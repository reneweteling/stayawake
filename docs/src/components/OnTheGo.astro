---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const steps: [string, string][] = [
  ['Start the agent on the Mac.', 'Claude Code, Codex or whatever you run, in a terminal like always.'],
  ['Click the moon in the menu bar and flip Stay awake.', 'Pull the power cable while it is on and it asks if it should keep going on battery.'],
  ['Join your phone’s hotspot, then connect from the phone.', 'Use your agent’s own remote or mobile option. StayAwake keeps the Mac and its connection up, it is not the link itself.'],
  ['Close the lid and pack it.', 'The Mac keeps working in the bag. When the battery hits 43 °C, the charge drops under 40%, the network is gone for 15 min or 8 hours have passed, it lets the Mac sleep.'],
];
---
<section class="block" id="on-the-go">
  <div class="wrap grid">
    <figure>
      <img src={`${base}assets/feature-onthego.webp`} width="1200" height="898" loading="lazy" alt="Someone on an evening train following a coding agent on their phone, with a closed laptop in the backpack next to them." />
    </figure>
    <div>
      <h2>How I use it</h2>
      <p class="lede">I start a long task, close the lid and follow along from my phone on the train. macOS normally sleeps the moment the lid shuts on battery. StayAwake stops that, within limits.</p>
      <ol>
        {steps.map(([t, p]) => <li><h3>{t}</h3><p>{p}</p></li>)}
      </ol>
    </div>
  </div>
</section>
<style>
  .grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 72px; align-items: start; }
  figure { margin: 8px 0 0; }
  figure img { display: block; width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; object-position: 100% 50%; border-radius: 12px; }
  ol { list-style: none; counter-reset: s; margin: 40px 0 0; padding: 0; display: grid; gap: 22px; }
  li { counter-increment: s; display: grid; grid-template-columns: 28px 1fr; column-gap: 12px; }
  li::before { content: counter(s); grid-row: span 2; font: 500 14px/1.6 var(--mono); color: var(--dim); padding-top: 1px; }
  li p { color: var(--muted); margin-top: 2px; max-width: 54ch; }
  @media (max-width: 880px) {
    .grid { grid-template-columns: 1fr; gap: 40px; }
    figure { order: 2; margin: 0; }
    figure img { aspect-ratio: 4 / 3; }
  }
</style>
