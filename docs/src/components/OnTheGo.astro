---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const steps = [
  ['Start your agents and arm StayAwake', 'Open Claude Code, Codex or any agent in a terminal. Click the moon in the menu bar and flip Stay awake.'],
  ['Connect from your phone and close the lid', 'Use your agent tool’s remote or mobile option, and put your phone on hotspot for the network. Then close the MacBook and drop it in your bag.'],
  ['Keep steering from your phone', 'The Mac keeps working in your bag while you commute, travel or walk. StayAwake stops it safely if it gets hot, the battery runs low, the network drops or your schedule says stop.'],
];
---
<section class="block" id="on-the-go">
  <div class="wrap">
    <div class="sec-head" data-reveal>
      <span class="kicker">AI on the go</span>
      <h2>Your agents, on the go.</h2>
      <p class="sub">StayAwake is built for running Claude Code, Codex and other coding agents while you are on the move. Your laptop stays in your bag. The work does not stop.</p>
    </div>
    <div class="cols">
      <div class="left">
        <figure class="figure" data-reveal><img src={`${base}assets/feature-onthego.webp`} width="1200" height="898" loading="lazy" alt="A commuter on a night train steering a coding agent from a phone, while a closed laptop glows softly amber in a backpack beside them." /></figure>
        <div class="link" aria-hidden="true" data-reveal style="--d:120ms">
          <div class="phone">
            <span class="mono lab"><i class="dot"></i>Phone</span>
            <div class="log mono">
              <p><b>&gt;</b> refactor parser</p>
              <p class="l2">editing 4 files</p>
              <p class="l3">running tests</p>
              <p class="l4 ok">18 passed</p>
            </div>
          </div>
          <svg class="wire" viewBox="0 0 200 40" preserveAspectRatio="none"><path class="base" d="M0 20 H200" /><path class="flow" d="M0 20 H200" /></svg>
          <div class="bag">
            <span class="mono lab"><i class="dot amber"></i>Mac in bag</span>
            <svg viewBox="0 0 80 52" width="80" height="52"><rect class="pack" x="8" y="4" width="64" height="44" rx="14" /><rect class="lid" x="22" y="24" width="36" height="5" rx="2.5" /></svg>
            <span class="mono st">52 °C / 71%</span>
          </div>
        </div>
      </div>
      <ol>
        {steps.map(([t, p], i) => (
          <li data-reveal style={`--d:${i * 110}ms`}><span>{i + 1}</span><div><b>{t}</b><p>{p}</p></div></li>
        ))}
      </ol>
    </div>
  </div>
</section>
<style>
  #on-the-go { padding-top: 72px; }
  .cols { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 48px; align-items: start; }
  .left { display: grid; gap: 20px; }
  ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 28px; }
  li { display: grid; grid-template-columns: 44px 1fr; gap: 16px; }
  li span { width: 44px; height: 44px; border-radius: 10px; background: var(--accent); color: var(--accent-ink); display: grid; place-items: center; font: 800 1.5rem/1 var(--display); }
  li b { font: 800 1.35rem/1.1 var(--display); text-transform: uppercase; display: block; margin-bottom: 4px; }
  li p { color: var(--muted); }
  .link { display: grid; grid-template-columns: auto minmax(40px, 1fr) auto; align-items: center; gap: 12px; background: var(--surface-2); border: 1px solid var(--hero-line); border-radius: 16px; padding: 18px 20px; }
  .lab { display: flex; align-items: center; gap: 8px; font-size: 11px; color: var(--muted); text-transform: uppercase; letter-spacing: .1em; margin-bottom: 8px; }
  .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--safe); }
  .dot.amber { background: var(--accent); }
  .log { background: var(--hero-bg); border-radius: 10px; padding: 10px 12px; font-size: 12px; line-height: 1.6; min-width: 150px; color: var(--hero-ink); }
  .log p { margin: 0; color: inherit; white-space: nowrap; }
  .log b { color: var(--accent); }
  .log .ok { color: var(--safe); }
  .l2, .l3 { color: var(--muted); }
  .wire { width: 100%; height: 40px; overflow: visible; }
  .wire path { fill: none; stroke-width: 2; vector-effect: non-scaling-stroke; stroke-linecap: round; }
  .wire .base { stroke: #3a4a4d; }
  .wire .flow { stroke: var(--accent); stroke-dasharray: 6 14; }
  .bag { display: grid; justify-items: center; }
  .bag .lab { justify-self: start; }
  .pack { fill: #162427; stroke: #3a4a4d; stroke-width: 1.5; }
  .lid { fill: var(--accent); }
  .st { margin-top: 6px; font-size: 11px; color: var(--safe); }
  @media (prefers-reduced-motion: no-preference) {
    .wire .flow { animation: flow 1.1s linear infinite; }
    .lid { animation: pulse 3.2s ease-in-out infinite; filter: drop-shadow(0 0 6px var(--accent)); }
    .dot { animation: pulse 2s ease-in-out infinite; }
    .log p { opacity: 0; animation: tick 8s steps(1, end) infinite; }
    .log p:nth-child(1) { animation-delay: 0s; }
    .log p:nth-child(2) { animation-delay: .9s; }
    .log p:nth-child(3) { animation-delay: 1.9s; }
    .log p:nth-child(4) { animation-delay: 3s; }
  }
  @keyframes flow { to { stroke-dashoffset: -20; } }
  @keyframes pulse { 0%, 100% { opacity: .45; } 50% { opacity: 1; } }
  @keyframes tick { 0% { opacity: 0; } 2%, 88% { opacity: 1; } 96%, 100% { opacity: 0; } }
  @media (max-width: 820px) { .cols { grid-template-columns: 1fr; gap: 36px; } }
  @media (max-width: 460px) { .link { grid-template-columns: 1fr; justify-items: stretch; } .wire { height: 24px; transform: none; } .bag { justify-items: start; } }
</style>
