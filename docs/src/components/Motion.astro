<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const $ = (s: string, r: ParentNode = document) => r.querySelector(s) as HTMLElement | null;

  // Hero parallax
  const bg = $('.hero .bg');
  if (bg && !reduce) {
    let ticking = false;
    const apply = () => {
      ticking = false;
      const y = Math.min(window.scrollY, 900);
      bg.style.transform = `translate3d(0, ${y * 0.14}px, 0) scale(1.04)`;
    };
    window.addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(apply); } }, { passive: true });
    apply();
  }

  const countUp = (el: HTMLElement) => {
    const m = (el.textContent || '').match(/^(\d+)(.*)$/);
    if (!m) return;
    const end = +m[1], rest = m[2], t0 = performance.now(), dur = 1300;
    const step = (t: number) => {
      const p = Math.min(1, (t - t0) / dur);
      el.textContent = Math.round(end * (1 - Math.pow(1 - p, 3))) + rest;
      if (p < 1) requestAnimationFrame(step);
    };
    el.textContent = '0' + rest;
    requestAnimationFrame(step);
  };

  const sweep = (wrap: Element) => {
    wrap.querySelectorAll('tbody tr').forEach((r, i) => {
      setTimeout(() => r.classList.add('lit'), 900 + i * 150);
      setTimeout(() => r.classList.remove('lit'), 900 + i * 150 + 650);
    });
  };

  const targets = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
  if (reduce || !('IntersectionObserver' in window)) {
    targets.forEach((t) => t.removeAttribute('data-reveal'));
  } else {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        const el = e.target as HTMLElement;
        io.unobserve(el);
        el.classList.add('in');
        const d = parseInt(el.style.getPropertyValue('--d') || '0', 10);
        el.querySelectorAll<HTMLElement>('[data-count]').forEach((c) => setTimeout(() => countUp(c), d));
        setTimeout(() => { el.removeAttribute('data-reveal'); el.classList.remove('in'); }, d + 1900);
      }
    }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
    targets.forEach((t) => io.observe(t));

    const tw = $('[data-rows]');
    if (tw) {
      const so = new IntersectionObserver((es) => { if (es[0].isIntersecting) { so.disconnect(); sweep(tw); } }, { threshold: 0.3 });
      so.observe(tw);
    }
  }

  // Story: the popover, scripted
  const card = $('[data-story]');
  if (card && !reduce) {
    const story = card.closest('.story') as HTMLElement;
    const q = (s: string) => $(s, card) as HTMLElement;
    const ring = q('.ring .val') as unknown as SVGElement;
    const held = q('[data-held]'), cpuEl = q('[data-cpu]'), bat = q('[data-bat]'), lid = q('[data-lid]');
    const next = q('[data-next]'), bar = q('[data-bar]'), note = q('[data-note-text]'), noteBox = q('[data-note]');
    const mb = $('[data-mb]') as HTMLElement;
    const wait = (ms: number) => new Promise<void>((r) => setTimeout(r, ms));
    let alive = true;

    const setState = (s: '' | 'warm' | 'hot') => {
      card.classList.toggle('warm', s === 'warm');
      card.classList.toggle('hot', s === 'hot');
      story.classList.toggle('hot', s === 'hot');
    };
    const setCpu = (c: number) => {
      cpuEl.textContent = `${Math.round(c)} °C`;
      mb.textContent = `${Math.round(c)}°`;
      (ring as any).style.strokeDashoffset = String(100 - Math.min(100, (c / 90) * 72));
    };
    const say = (t: string) => {
      noteBox.animate([{ transform: 'scale(.96)', opacity: 0.3 }, { transform: 'scale(1.02)', opacity: 1 }, { transform: 'scale(1)', opacity: 1 }], { duration: 420, easing: 'ease-out' });
      note.textContent = t;
    };
    const fmt = (m: number) => `${Math.floor(m / 60)} h ${String(m % 60).padStart(2, '0')} min`;
    let minutes = 72, onBat = 48, batt = 71;
    const render = (cpu: number) => {
      held.textContent = `Holding for ${fmt(minutes)}, until 18:00`;
      lid.textContent = `Closed, on battery ${onBat} min`;
      bat.textContent = `${batt}%`;
      const left = 90 - onBat;
      const near = cpu >= 84;
      next.textContent = near ? `CPU ${90 - Math.round(cpu)} °C from the limit` : `Lid on battery, ${left} min left`;
      bar.style.transform = `scaleX(${near ? Math.max(0.05, (90 - cpu) / 22) : left / 90})`;
    };

    const loop = async () => {
      for (;;) {
        while (!alive) await wait(300);
        minutes = 72; onBat = 48; batt = 71;
        card.classList.remove('off'); setState('');
        setCpu(46); render(46); say('Holding awake on mains. Cable in.');
        await wait(1800);
        setCpu(58); render(58); say('Unplugged. StayAwake keeps this Mac awake on battery.');
        for (let i = 0; i < 5; i++) { await wait(520); minutes++; onBat++; if (i % 2) batt--; render(58); }
        say('Warming up. Watching the limits.');
        for (let c = 58; c <= 90; c += 2) { setCpu(c); if (c >= 82) setState('warm'); minutes += 1; onBat += 1; render(c); await wait(280); }
        setCpu(91); setState('hot'); card.classList.add('off');
        say('HOT 91°. Limit reached, releasing now.'); held.textContent = `Released after ${fmt(minutes)}`;
        next.textContent = 'CPU 90 °C reached';
        bar.style.transform = 'scaleX(.05)';
        await wait(2400);
        setState(''); say('Sleep restored. The Mac can sleep again.');
        for (let c = 91; c > 56; c -= 5) { setCpu(c); await wait(220); }
        setCpu(56); next.textContent = 'Idle, nothing held'; held.textContent = `Released after ${fmt(minutes)}`;
        await wait(2800);
      }
    };
    new IntersectionObserver((es) => { alive = es[0].isIntersecting; }, { threshold: 0.25 }).observe(card);
    const start = new IntersectionObserver((es) => { if (es[0].isIntersecting) { start.disconnect(); loop(); } }, { threshold: 0.4 });
    start.observe(card);
  }
</script>
