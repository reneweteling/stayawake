---
const rules = [
  ['Lease', 'The helper only holds while the app keeps renewing.', 'App crash, hang or force quit: sleep is back within 60 s.'],
  ['Boot check', 'The helper restores sleep on every boot.', 'A lease from another boot session is void.'],
  ['Two commands', 'The helper runs pmset -a disablesleep 1 or 0, nothing else.', 'No shell, no client strings, signed clients only.'],
  ['Fail closed', 'A missing or stuck sensor is treated as hot.', 'Sustain and hysteresis stop one spike or a flapping value from deciding.'],
];
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<section class="block" id="decides">
  <div class="wrap">
    <div class="sec-head split">
      <figure class="figure" data-reveal><img src={`${base}assets/feature-failsafe.webp`} width="1200" height="898" loading="lazy" alt="A closed laptop under a green shield dome, with heat and an empty battery kept outside." /></figure>
      <div data-reveal style="--d:120ms">
        <span class="kicker">Fail-safe</span>
        <h2>Four layers.<br />No forgotten switch.</h2>
      </div>
    </div>
    <div class="cards">
      {rules.map(([t, a, b], i) => (
        <article data-reveal style={`--d:${i * 110}ms`}>
          <span class="n mono">0{i + 1}</span>
          <h3>{t}</h3>
          <p>{a}</p>
          <p class="b">{b}</p>
        </article>
      ))}
    </div>
    <pre class="ex" data-reveal style="--d:200ms"><code><span class="d">$ sudo pmset -a disablesleep 0</span>
<span class="y">  last resort, also shown by StayAwake --restore and in About</span></code></pre>
  </div>
</section>
<style>
  .split { display: grid; grid-template-columns: 1.1fr 1fr; gap: 56px; align-items: center; }
  .split h2 { text-wrap: balance; }
  @media (max-width: 860px) { .split { grid-template-columns: 1fr; gap: 32px; } .split > div { order: -1; } }
  .ex { max-width: 100%; }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 0; border: 1px solid var(--line); border-radius: 16px; overflow: hidden; }
  article { padding: 28px 24px 32px; border-right: 1px solid var(--line); background: var(--surface); display: grid; gap: 12px; align-content: start; }
  article:last-child { border-right: 0; }
  .n { color: var(--safe); font-size: 13px; }
  h3 { text-transform: uppercase; font-size: 1.7rem; }
  article { transition: background-color .3s; }
  article:hover { background: var(--surface-2); }
  article:hover h3 { color: var(--accent); }
  h3 { transition: color .3s; }
  article p { color: var(--ink); }
  article .b { color: var(--muted); font-size: 15px; }
  .ex { margin: 32px 0 0; border: 1px solid var(--line); background: var(--surface); color: var(--hero-ink); border-radius: 14px; padding: 22px 24px; overflow-x: auto; font: 14px/1.7 var(--mono); }
  .ex .d { color: var(--hero-ink); }
  .ex .y { color: var(--hero-muted); }
  @media (max-width: 640px) { article { border-right: 0; border-bottom: 1px solid var(--line); } article:last-child { border-bottom: 0; } }
</style>
