---
// A faithful HTML copy of the StayAwake menu bar popover (Sources/StayAwake/UI/PopoverView.swift).
// Same rows, same labels, same default limits. A short script plays one real run:
// holding on battery in a bag, the battery warms up, the 43 °C rule stops it.
---
<div class="pv" data-pv role="img" aria-label="The StayAwake popover while it keeps a closed MacBook awake on battery: CPU temperature 61 °C of 102, battery temperature 34 °C of 43, battery charge 71% with a stop at 20%, first to stop it: lid on battery, 42 minutes left.">
  <div class="mbar" aria-hidden="true">
    <span class="item" data-item>
      <svg class="cup" viewBox="0 0 16 16" width="15" height="15"><path d="M2.5 5h8.5v4.2a3.8 3.8 0 0 1-3.8 3.8H6.3a3.8 3.8 0 0 1-3.8-3.8V5Z" fill="currentColor" /><path d="M11 6.4h.9a1.8 1.8 0 0 1 0 3.6H11" fill="none" stroke="currentColor" stroke-width="1.4" /><rect x="1.5" y="13.6" width="11" height="1.2" rx=".6" fill="currentColor" /></svg>
      <svg class="warn" viewBox="0 0 16 16" width="14" height="14"><path d="M8 1.6 15 14H1L8 1.6Z" fill="currentColor" /><rect x="7.25" y="6" width="1.5" height="4.2" rx=".7" fill="#1b2224" /><circle cx="8" cy="11.9" r=".9" fill="#1b2224" /></svg>
      <span data-title>61° 71%</span>
    </span>
    <span class="clock">Thu 10:42</span>
  </div>

  <div class="pop" aria-hidden="true">
    <div class="head">
      <svg class="sym" viewBox="0 0 16 16" width="15" height="15"><path d="M2.5 5h8.5v4.2a3.8 3.8 0 0 1-3.8 3.8H6.3a3.8 3.8 0 0 1-3.8-3.8V5Z" fill="currentColor" /><path d="M11 6.4h.9a1.8 1.8 0 0 1 0 3.6H11" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
      <b>Stay awake</b>
      <span class="sw" data-sw></span>
    </div>
    <p class="sub" data-sub>Awake for 1 h 12 min · 42 min left (lid closed)</p>

    <div class="tripped" data-tripped>
      <b>Stopped, normal sleep is back</b>
      <p data-trip-msg>10:58 · Battery temperature 43 °C is at or above 43 °C for 60 s</p>
      <span class="pbtn">Turn On Again</span>
    </div>

    <hr />
    <div class="rows">
      <div class="r"><span>CPU temperature</span><span data-cpu>61 °C / 102</span></div>
      <div class="r"><span>GPU temperature</span><span data-gpu>48 °C / 100</span></div>
      <div class="r"><span>Battery temperature</span><span data-bt>34 °C / 43</span></div>
      <div class="r"><span>Battery charge</span><span data-bc>71% / stops at 20%</span></div>
      <div class="bar"><i data-bar style="width:71%"></i></div>
      <p class="cap">On battery, discharging</p>
      <div class="r"><span>Lid</span><span data-lid>Closed · on battery 48 min</span></div>
      <div class="r"><span>Network</span><span>Online</span></div>
      <div class="r"><span>Mac sleep</span><span data-sleep>Blocked</span></div>
    </div>
    <div class="next" data-next-wrap>
      <hr />
      <div class="r"><span>First to stop it</span><span data-next>Lid on battery · 42 min left</span></div>
    </div>
    <hr />
    <div class="r keep"><span>Keep awake</span><span class="pick">Until a limit stops it</span></div>
    <p class="cap" data-event>09:54 · Unplugged while armed</p>
    <hr />
    <div class="foot"><span>Settings…</span><span>Open log</span><span>Allow sleep</span><span class="q">Quit</span></div>
  </div>
</div>

<style>
  .pv { width: 100%; max-width: 380px; min-height: 520px; font: 13px/1.35 var(--sys); color: #e9ecec; letter-spacing: 0; }
  .mbar { display: flex; justify-content: flex-end; align-items: center; gap: 4px; height: 26px; padding: 0 8px; border-radius: 7px 7px 0 0; background: #1b2224; border: 1px solid #263236; border-bottom: 0; font-weight: 500; -webkit-mask-image: linear-gradient(90deg, transparent, #000 45%); mask-image: linear-gradient(90deg, transparent, #000 45%); }
  .item { display: inline-flex; align-items: center; gap: 5px; height: 21px; padding: 0 7px; border-radius: 4px; background: rgba(255,255,255,.14); font-variant-numeric: tabular-nums; }
  .item .warn { display: none; }
  .clock { padding: 0 6px; color: #d7dcdc; }
  .pop { margin: 6px 0 0 auto; width: min(100%, 320px); padding: 14px 16px 12px; border-radius: 11px; background: #22292b; border: 1px solid #344044; box-shadow: 0 0 0 .5px #000, 0 18px 40px -12px rgba(0,0,0,.7); display: grid; gap: 8px; }
  .head { display: flex; align-items: center; gap: 7px; }
  .head b { font-size: 13px; font-weight: 600; margin-right: auto; }
  .sym { color: #e9ecec; }
  .sw { width: 32px; height: 19px; border-radius: 10px; background: var(--safe); position: relative; transition: background-color .25s; }
  .sw::after { content: ""; position: absolute; top: 2px; left: 15px; width: 15px; height: 15px; border-radius: 50%; background: #fff; box-shadow: 0 1px 2px rgba(0,0,0,.4); transition: left .25s; }
  .sub, .cap { font-size: 11px; color: #98a3a5; }
  hr { border: 0; border-top: 1px solid #39454a; margin: 2px 0; }
  .rows { display: grid; gap: 5px; }
  .r { display: flex; justify-content: space-between; gap: 12px; white-space: nowrap; }
  .r span:last-child { font-variant-numeric: tabular-nums; text-align: right; transition: color .3s; }
  .bar { height: 5px; border-radius: 3px; background: #3a4549; overflow: hidden; margin-top: 1px; }
  .bar i { display: block; height: 100%; background: #e9ecec; border-radius: 3px; transition: width .6s; }
  .keep { align-items: center; }
  .pick { padding: 2px 22px 2px 8px; border-radius: 5px; background: #3a4549; color: #aab4b6; position: relative; }
  .pick::after { content: "⌄"; position: absolute; right: 7px; top: -2px; font-size: 12px; }
  .foot { display: flex; gap: 12px; color: #8fb8ff; }
  .foot .q { margin-left: auto; }
  .tripped { display: none; gap: 5px; }
  .tripped b { font-size: 13px; font-weight: 600; }
  .tripped p { font-size: 12px; color: #d7dcdc; white-space: normal; }
  .pbtn { justify-self: start; margin-top: 2px; padding: 2px 10px; border-radius: 5px; background: #4a5559; font-size: 12px; }
  .amber { color: var(--accent); }
  .red { color: var(--hot); }

  .pv.trip .tripped { display: grid; }
  .pv.trip .next { display: none; }
  .pv.trip .sw { background: #4a5559; }
  .pv.trip .sw::after { left: 2px; }
  .pv.trip .item { color: var(--hot); }
  .pv.trip .item .cup { display: none; }
  .pv.trip .item .warn { display: inline; }
  .pv.warn .item { color: var(--accent); }

  @media (max-width: 420px) {
    .pv { font-size: 12px; }
    .pop { padding: 12px 13px 10px; }
    .foot { gap: 10px; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-pv]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (root && !reduce) {
    const q = (s: string) => root.querySelector<HTMLElement>(s)!;
    const el = {
      title: q('[data-title]'), sub: q('[data-sub]'), cpu: q('[data-cpu]'), gpu: q('[data-gpu]'), bt: q('[data-bt]'),
      bc: q('[data-bc]'), bar: q('[data-bar]'), lid: q('[data-lid]'), sleep: q('[data-sleep]'), next: q('[data-next]'),
      event: q('[data-event]'), msg: q('[data-trip-msg]'),
    };
    const wait = (ms: number) => new Promise<void>((r) => setTimeout(r, ms));
    const dur = (m: number) => (m >= 60 ? `${Math.floor(m / 60)} h ${m % 60} min` : `${m} min`);
    const clock = (m: number) => `${String(Math.floor(m / 60)).padStart(2, '0')}:${String(m % 60).padStart(2, '0')}`;
    let visible = true;
    new IntersectionObserver((es) => { visible = es[0].isIntersecting; }).observe(root);

    // One run: armed at 09:30, unplugged at 09:54, now 10:42. The bag warms the battery up.
    const render = (held: number, cpu: number, bt: number, pct: number) => {
      const onBattery = held - 24;
      const left = 90 - onBattery;
      const warn = bt >= 41;
      el.title.textContent = `${cpu}° ${pct}%`;
      el.sub.textContent = `Awake for ${dur(held)} · ${dur(left)} left (lid closed)`;
      el.cpu.textContent = `${cpu} °C / 102`;
      el.gpu.textContent = `${Math.round(cpu * 0.78)} °C / 100`;
      el.bt.textContent = `${bt} °C / 43`;
      el.bc.textContent = `${pct}% / stops at 20%`;
      el.bar.style.width = `${pct}%`;
      el.lid.textContent = `Closed · on battery ${dur(onBattery)}`;
      el.next.textContent = warn ? `Battery ${bt}° of 43°` : `Lid on battery · ${dur(left)} left`;
      el.bt.classList.toggle('amber', warn);
      el.next.classList.toggle('amber', warn);
      root.classList.toggle('warn', warn);
    };
    const reset = () => {
      root.classList.remove('trip', 'warn');
      el.bt.classList.remove('red');
      el.sleep.textContent = 'Blocked';
      el.event.textContent = '09:54 · Unplugged while armed';
      render(72, 61, 34, 71);
    };

    const run = async () => {
      for (;;) {
        reset();
        await wait(3000);
        let held = 72, pct = 71, bt = 34;
        const cpus = [63, 66, 64, 62, 65, 67, 64, 63, 66];
        for (let i = 0; bt < 43; i++) {
          while (!visible) await wait(400);
          held += 2; bt += 1; if (i % 2) pct -= 1;
          render(held, cpus[i % cpus.length], bt, pct);
          await wait(bt >= 41 ? 1300 : 750);
        }
        const at = clock(9 * 60 + 30 + held);
        root.classList.remove('warn');
        root.classList.add('trip');
        el.bt.classList.remove('amber');
        el.bt.classList.add('red');
        el.title.textContent = 'BATT HOT 43°';
        el.sub.textContent = 'Stopped. The Mac sleeps as usual again.';
        el.sleep.textContent = 'Normal';
        el.msg.textContent = `${at} · Battery temperature 43 °C is at or above 43 °C for 60 s`;
        el.event.textContent = `${at} · Battery temperature 43 °C is at or above 43 °C for 60 s`;
        await wait(5200);
      }
    };
    const start = new IntersectionObserver((es) => { if (es[0].isIntersecting) { start.disconnect(); run(); } }, { threshold: 0.3 });
    start.observe(root);
  }
</script>
