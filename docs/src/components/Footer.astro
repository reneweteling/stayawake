---
const year = new Date().getFullYear();
---
<footer>
  <div class="wrap bar">
    <span>StayAwake by <a href="https://www.weteling.com" target="_blank" rel="noopener">René Weteling</a>. Felobo B.V. &copy; {year}</span>
    <nav aria-label="Footer links">
      <a href="https://github.com/reneweteling/stayawake" target="_blank" rel="noopener">Source</a>
      <a href="https://github.com/reneweteling/stayawake/issues" target="_blank" rel="noopener">Issues</a>
      <a href="https://polyformproject.org/licenses/noncommercial/1.0.0" target="_blank" rel="noopener">PolyForm Noncommercial 1.0.0</a>
    </nav>
  </div>
</footer>
<style>
  footer { border-top: 1px solid var(--line); padding: 32px 0 40px; color: var(--dim); font-size: 14px; }
  .bar { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 16px; }
  nav { display: flex; flex-wrap: wrap; gap: 8px 24px; }
  a { text-decoration: none; color: var(--muted); }
  a:hover { color: var(--ink); }
</style>
