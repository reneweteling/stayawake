---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const site = 'https://www.weteling.com';
const apps: [string, string, string][] = [
  ['TidyDrive', 'https://reneweteling.github.io/tidydrive/', 'Your disk is full. Take it back.'],
  ['Loft', 'https://reneweteling.github.io/loft-app/', 'Drag a file to your menu bar, get a link back.'],
  ['fckr', 'https://reneweteling.github.io/fckr/', 'Make your colleagues’ Macs talk. From your terminal.'],
  ['HeadsUp', 'https://headsup-app.com', 'Your group chats, turned into one morning to-do list.'],
  ['FooterManager', 'https://footermanager.com', 'Email signatures that manage themselves.'],
];
---
<section class="block" id="maker" aria-labelledby="maker-title">
  <div class="wrap grid">
    <img src={`${base}assets/rene.jpg`} alt="René Weteling" width="720" height="720" loading="lazy" />
    <div>
      <h2 id="maker-title">Made by René Weteling</h2>
      <p class="lede">I build products with a fleet of AI agents and bring the engineering judgement that keeps them honest. I wrote StayAwake because I wanted those agents to keep going while I was on the train.</p>
      <p class="lede">Want that speed on your own product? Idea to production, CTO as a service, or a second pair of senior eyes.</p>
      <div class="cta">
        <a class="btn primary" href={`${site}/#contact`} target="_blank" rel="noopener">Start a project</a>
        <a class="btn ghost" href={site} target="_blank" rel="noopener">weteling.com</a>
      </div>
      <h3>Other apps</h3>
      <ul>
        {apps.map(([n, u, d]) => <li><a href={u} target="_blank" rel="noopener">{n}</a><span>{d}</span></li>)}
        <li><a href={`${site}/#apps`} target="_blank" rel="noopener">All apps</a><span>The rest are on weteling.com.</span></li>
      </ul>
    </div>
  </div>
</section>
<style>
  .grid { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 48px; align-items: start; }
  img { width: 100%; max-width: 300px; height: auto; aspect-ratio: 1; object-fit: cover; border-radius: 12px; display: block; filter: grayscale(.2); }
  .lede { margin-top: 16px; }
  .cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  h3 { margin-top: 56px; font-size: 15px; color: var(--muted); font-weight: 600; }
  ul { list-style: none; margin: 14px 0 0; padding: 0; display: grid; gap: 10px; }
  li { display: grid; grid-template-columns: 140px 1fr; gap: 16px; font-size: 15px; }
  li a { font-weight: 600; text-decoration: none; }
  li a:hover { color: var(--accent); }
  li span { color: var(--muted); }
  @media (max-width: 880px) { .grid { grid-template-columns: 1fr; gap: 32px; } img { max-width: 180px; } }
  @media (max-width: 480px) { li { grid-template-columns: 1fr; gap: 0; } }
</style>
