---
import '../styles/global.css';
import Hero from '../components/Hero.astro';
import OnTheGo from '../components/OnTheGo.astro';
import Rules from '../components/Rules.astro';
import Compare from '../components/Compare.astro';
import Failsafe from '../components/Failsafe.astro';
import Steps from '../components/Steps.astro';
import Faq from '../components/Faq.astro';
import Maker from '../components/Maker.astro';
import Footer from '../components/Footer.astro';
import { faq } from '../data/faq';

let version = '1.2.1';
try {
  const r = await fetch('https://api.github.com/repos/reneweteling/stayawake/releases/latest', { headers: { 'User-Agent': 'stayawake-site' } });
  if (r.ok) version = String((await r.json()).tag_name ?? version).replace(/^v/, '');
} catch {}

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const title = 'StayAwake: keep a closed MacBook awake on battery for AI agents';
const description = 'Run Claude Code, Codex and other AI agents on the go. StayAwake is a free macOS menu bar app that keeps a closed MacBook awake on battery while you steer from your phone, and stops safely on heat, a low battery, a dropped network or your schedule.';
const site = 'https://reneweteling.github.io/stayawake/';
const ogImage = `${site}assets/og.png`;
const ogAlt = 'StayAwake app icon, the headline Agents keep working. Laptop in your bag. and the menu bar popover showing temperatures and battery limits.';
const download = 'https://github.com/reneweteling/stayawake/releases/latest/download/StayAwake.dmg';

const person = {
  '@type': 'Person',
  '@id': 'https://www.weteling.com/#person',
  name: 'René Weteling',
  url: 'https://www.weteling.com',
  image: `${site}assets/rene.jpg`,
  sameAs: ['https://github.com/reneweteling'],
};
const org = { '@type': 'Organization', '@id': 'https://www.weteling.com/#org', name: 'Felobo B.V.', url: 'https://www.weteling.com' };
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${site}#website`,
      url: site,
      name: 'StayAwake',
      inLanguage: 'en',
      publisher: { '@id': person['@id'] },
    },
    {
      '@type': 'SoftwareApplication',
      '@id': `${site}#app`,
      name: 'StayAwake',
      description,
      url: site,
      image: `${site}assets/icon.png`,
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'macOS 14 or later (Apple Silicon)',
      softwareVersion: version,
      screenshot: `${site}assets/og.png`,
      downloadUrl: download,
      installUrl: download,
      license: 'https://polyformproject.org/licenses/noncommercial/1.0.0',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
      featureList: [
        'Keeps AI coding agents running while your closed MacBook is in your bag',
        'One click keeps a closed MacBook awake on battery',
        'Root helper with a lease: sleep returns after a crash, a quit or a reboot',
        'Lets the Mac sleep at 43 °C battery temperature, a 100 °C CPU average, thermal pressure or 40% battery',
        'Allowed hours per weekday, lid-closed time limit, idle, no network and an 8 hour cap',
        'Unreadable sensors count as a trip',
        'Alert when the power cable comes out while armed',
      ],
      author: [{ '@id': person['@id'] }, { '@id': org['@id'] }],
      publisher: { '@id': org['@id'] },
    },
    person,
    org,
    {
      '@type': 'HowTo',
      '@id': `${site}#install`,
      name: 'How to install StayAwake and keep a closed MacBook awake on battery',
      step: [
        { '@type': 'HowToStep', position: 1, name: 'Download', text: 'Download StayAwake.dmg from the latest GitHub release.', url: download },
        { '@type': 'HowToStep', position: 2, name: 'Install', text: 'Drag StayAwake into Applications.' },
        { '@type': 'HowToStep', position: 3, name: 'Approve the helper', text: 'Approve the helper once in System Settings, Login Items.' },
        { '@type': 'HowToStep', position: 4, name: 'Turn it on', text: 'Click the moon in the menu bar and flip Stay awake, then close the lid.' },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${site}#faq`,
      mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
    },
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={site} />
    <meta name="author" content="René Weteling" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#0b1112" />
    <meta name="color-scheme" content="dark" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="StayAwake" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={site} />
    <meta property="og:title" content="StayAwake: agents keep working, laptop in your bag" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="StayAwake: agents keep working, laptop in your bag" />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />

    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48" href={`${base}favicon.ico`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${base}favicon-16.png`} />
    <link rel="icon" type="image/png" sizes="192x192" href={`${base}icon-192.png`} />
    <link rel="icon" type="image/png" sizes="512x512" href={`${base}icon-512.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}site.webmanifest`} />
    <link rel="sitemap" href={`${base}sitemap.xml`} />
    <link rel="alternate" type="text/plain" title="LLM summary" href={`${base}llms.txt`} />
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <Hero />
    <OnTheGo />
    <Rules />
    <Failsafe />
    <Compare />
    <Steps />
    <Faq />
    <Maker />
    <Footer />
  </body>
</html>
