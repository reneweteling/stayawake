{
  "name": "stayawake",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "homepage": "https://reneweteling.github.io/stayawake/",
  "repository": {
    "type": "git",
    "url": "https://github.com/reneweteling/stayawake.git"
  },
  "bugs": {
    "url": "https://github.com/reneweteling/stayawake/issues"
  },
  "scripts": {
    "semantic-release": "semantic-release",
    "prepare": "husky"
  },
  "release": {
    "branch": "main",
    "repositoryUrl": "https://github.com/reneweteling/stayawake.git",
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/exec",
        {
          "verifyReleaseCmd": "./scripts/update-version.sh ${nextRelease.version}"
        }
      ],
      [
        "@semantic-release/git",
        {
          "assets": [
            "Sources/StayAwake/Resources/Info.plist"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
        }
      ],
      [
        "@semantic-release/github",
        {
          "assets": [
            {
              "path": "build/StayAwake.dmg",
              "label": "StayAwake v${nextRelease.version} for macOS (Apple Silicon)"
            }
          ]
        }
      ]
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "semantic-release": "^25.0.1",
    "typescript": "~5.8.3"
  }
}
